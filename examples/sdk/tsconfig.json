{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@astera-app/client": ["../../packages/client/src/index.ts"] }
  },
  "include": ["*.ts"],
  "exclude": ["*.test.ts"]
}
