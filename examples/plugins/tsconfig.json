{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@astera-app/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"],
      "@astera-app/client": ["../../packages/client/src/index.ts"]
    }
  },
  "include": ["*/*.mjs"]
}
