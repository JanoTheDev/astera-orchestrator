{
  "name": "astera",
  "version": "1.4.14",
  "desktopName": "astera.desktop",
  "private": true,
  "description": "Desktop app that plans, runs and reviews work across many Claude Code and Codex terminals: parallel workers in git worktrees, account rolling on usage limits, and delivery as a PR or a push.",
  "homepage": "https://github.com/JanoTheDev/astera-orchestrator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanoTheDev/astera-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/JanoTheDev/astera-orchestrator/issues"
  },
  "author": "JanoTheDev",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "check:codex-baseline": "node scripts/check-codex-baseline.mjs",
    "prebuild": "node scripts/gen-licenses.mjs",
    "build": "electron-vite build",
    "build:packages": "node scripts/build-packages.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p packages/client/tsconfig.json && tsc --noEmit -p packages/plugin-sdk/tsconfig.json && tsc --noEmit -p examples/sdk/tsconfig.json && tsc --noEmit -p examples/plugins/tsconfig.json",
    "test": "vitest run",
    "dist": "node scripts/dist-version.mjs electron-vite build + npm run host-runtime + node scripts/gen-licenses.mjs + electron-builder --publish never",
    "dist:win": "node scripts/dist-version.mjs electron-vite build + npm run host-runtime + node scripts/gen-licenses.mjs + electron-builder --win --publish never",
    "dist:mac": "node scripts/dist-version.mjs electron-vite build + node scripts/gen-licenses.mjs + electron-builder --mac --publish never",
    "dist:linux": "node scripts/dist-version.mjs electron-vite build + node scripts/gen-licenses.mjs + electron-builder --linux --publish never",
    "postinstall": "electron-builder install-app-deps",
    "host-runtime": "node scripts/host-runtime.mjs",
    "shots": "node scripts/shoot.mjs",
    "docs:dev": "node scripts/docs-site-sync.mjs && npm --prefix site run dev",
    "docs:build": "node scripts/docs-site-sync.mjs && npm --prefix site run build"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@assistant-ui/react-markdown": "^0.14.14",
    "@assistant-ui/store": "^0.3.12",
    "@assistant-ui/tap": "^0.9.16",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "@types/react": "^19.2.17",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "ignore": "^7.0.6",
    "lucide-react": "^1.34.0",
    "motion": "^14.6.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-gfm": "^4.0.1",
    "undici": "^7.30.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.6.5"
  }
}
