{
  "name": "@astera-app/plugin-sdk",
  "version": "0.2.0",
  "description": "Write Astera plugins: definePlugin and the plugin context's types.",
  "keywords": [
    "astera",
    "plugin",
    "sdk"
  ],
  "homepage": "https://github.com/JanoTheDev/astera-orchestrator/blob/main/docs/plugins.md",
  "bugs": {
    "url": "https://github.com/JanoTheDev/astera-orchestrator/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/build-packages.mjs"
  },
  "peerDependencies": {
    "@astera-app/client": ">=0.2.0 <1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanoTheDev/astera-orchestrator.git",
    "directory": "packages/plugin-sdk"
  }
}
